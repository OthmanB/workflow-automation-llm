{
  "$defs": {
    "AskOperatorCommand": {
      "additionalProperties": false,
      "description": "Request durable operator input without launching a session.",
      "properties": {
        "action": {
          "const": "ask_operator",
          "title": "Action",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "question": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "step_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        }
      },
      "required": [
        "protocol_version",
        "action",
        "question"
      ],
      "title": "AskOperatorCommand",
      "type": "object"
    },
    "BatchDispatchCommand": {
      "additionalProperties": false,
      "description": "Request an all-or-none set of independently validated child dispatches.",
      "properties": {
        "action": {
          "const": "dispatch_batch",
          "title": "Action",
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/DispatchRequest"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Children",
          "type": "array"
        },
        "protocol_version": {
          "const": 2,
          "title": "Protocol Version",
          "type": "integer"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "protocol_version",
        "action",
        "children"
      ],
      "title": "BatchDispatchCommand",
      "type": "object"
    },
    "DispatchCommand": {
      "additionalProperties": false,
      "description": "Request a single executor or reviewer dispatch by logical role key.",
      "properties": {
        "action": {
          "const": "dispatch",
          "title": "Action",
          "type": "string"
        },
        "prompt": {
          "maxLength": 50000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "repo_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo Id"
        },
        "session_mode": {
          "enum": [
            "new",
            "resume",
            "fork"
          ],
          "title": "Session Mode",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "title": "Step Id",
          "type": "string"
        },
        "target_role": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "title": "Target Role",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "target_role",
        "session_mode",
        "prompt",
        "protocol_version",
        "action"
      ],
      "title": "DispatchCommand",
      "type": "object"
    },
    "DispatchRequest": {
      "additionalProperties": false,
      "description": "One independently valid child request used by single and batch dispatches.",
      "properties": {
        "prompt": {
          "maxLength": 50000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "repo_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo Id"
        },
        "session_mode": {
          "enum": [
            "new",
            "resume",
            "fork"
          ],
          "title": "Session Mode",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "title": "Step Id",
          "type": "string"
        },
        "target_role": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "title": "Target Role",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "target_role",
        "session_mode",
        "prompt"
      ],
      "title": "DispatchRequest",
      "type": "object"
    },
    "HaltCommand": {
      "additionalProperties": false,
      "description": "Request an explicit halted state with a durable reason.",
      "properties": {
        "action": {
          "const": "halt",
          "title": "Action",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "action",
        "reason"
      ],
      "title": "HaltCommand",
      "type": "object"
    },
    "RequestCompletionCommand": {
      "additionalProperties": false,
      "description": "Ask the dispatcher to evaluate, rather than assume, completion.",
      "properties": {
        "action": {
          "const": "request_completion",
          "title": "Action",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "protocol_version",
        "action"
      ],
      "title": "RequestCompletionCommand",
      "type": "object"
    },
    "RequestReviewWaiverCommand": {
      "additionalProperties": false,
      "description": "Ask the operator to waive a non-mandatory compiled review obligation.",
      "properties": {
        "action": {
          "const": "request_review_waiver",
          "title": "Action",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "rationale": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "action",
        "step_id",
        "rationale"
      ],
      "title": "RequestReviewWaiverCommand",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "ask_operator": "#/$defs/AskOperatorCommand",
      "dispatch": "#/$defs/DispatchCommand",
      "dispatch_batch": "#/$defs/BatchDispatchCommand",
      "halt": "#/$defs/HaltCommand",
      "request_completion": "#/$defs/RequestCompletionCommand",
      "request_review_waiver": "#/$defs/RequestReviewWaiverCommand"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/DispatchCommand"
    },
    {
      "$ref": "#/$defs/BatchDispatchCommand"
    },
    {
      "$ref": "#/$defs/AskOperatorCommand"
    },
    {
      "$ref": "#/$defs/RequestReviewWaiverCommand"
    },
    {
      "$ref": "#/$defs/HaltCommand"
    },
    {
      "$ref": "#/$defs/RequestCompletionCommand"
    }
  ]
}
